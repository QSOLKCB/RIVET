    {"id":"audio.pcm","class":"media"},
    {"id":"threads","class":"acceleration"},
    {"id":"simd","class":"acceleration"},
    {"id":"document.url","class":"document"},
    {"id":"document.stream","class":"document"},
    {"id":"document.text.utf8","class":"document"},
    {"id":"document.html","class":"document"},
    {"id":"document.css","class":"document"},
    {"id":"document.layout","class":"document"},
    {"id":"document.links","class":"document"},
