{
  "schema": "rivet.gfx/v1",
  "version": 1,
  "authority": "GFX-v1.md",
  "abi_version": 1,
  "language_baseline": "C99",
  "public_header": "include/rivet/gfx.h",
  "reference_implementation": "gfx/raster.c",
  "pixel_format": {
    "id": "rgba8888-byte-order",
    "bytes_per_pixel": 4,
    "byte_order": [
      "R",
      "G",
      "B",
      "A"
    ],
    "host_endian_packing": false,
    "blending": "none-replace-only"
  },
  "memory": {
    "mandatory_heap": false,
    "surface_storage": "caller-owned",
    "stride": "explicit-bytes",
    "overflow_checks": true
  },
  "coordinates": {
    "origin_type": "signed-long",
    "dimension_type": "unsigned-long",
    "clip_bounds": "half-open",
    "empty_clip": "successful-no-op"
  },
  "operations": [
    "surface-attach-validate",
    "clip-reset-set",
    "replace-fill-rect",
    "mono1-msb-first-transparent-zero-blit",
    "overlap-safe-in-place-copy"
  ],
  "host_adapter": {
    "path": "platform/headless/ppm.c",
    "role": "evidence-only",
    "format": "PPM-P6",
    "platform_support_claim": false
  },
  "reference_vector": {
    "program": "examples/r2_gfx_proof.c",
    "width": 16,
    "height": 12,
    "stride_bytes": 64,
    "rgba_bytes": 768,
    "fnv1a64": "1c0020d75a3b782d",
    "ppm_sha256": "e525783bbdaaddd3cc193a855cd62b9a259d9074dc32125b79241dab3ed1d7cc"
  },
  "non_goals": [
    "heap-allocation",
    "alpha-blending",
    "antialiasing",
    "scaling",
    "image-codecs",
    "font-engine",
    "native-window",
    "ui",
    "input",
    "gpu",
    "simd",
    "threads",
    "dirty-region-scheduler",
    "display-list",
    "cache"
  ]
}
