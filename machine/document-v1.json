{
  "schema": "rivet.document/v1",
  "version": 1,
  "authority": "DOCUMENT-v1.md",
  "abi_version": 1,
  "language_baseline": "C99",
  "public_header": "include/rivet/document.h",
  "reference_sources": [
    "web/stream_url_utf8.c",
    "web/html_css.c",
    "web/layout_image.c"
  ],
  "memory": {
    "heap": false,
    "ownership": "caller-owned",
    "bounded_outputs": [
      "utf8-codepoints",
      "html-nodes",
      "css-rules",
      "layout-boxes",
      "image-pixels"
    ]
  },
  "limits": {
    "html_depth": 32,
    "html_attributes_per_element": 64,
    "html_image_dimension": 4096,
    "css_margin_pixels": 1024,
    "ppm_dimension": 4096,
    "layout_glyph_advance": 6,
    "layout_line_height": 8,
    "layout_input_width": 80,
    "layout_input_height": 12
  },
  "url": {
    "schemes": [
      "http",
      "https"
    ],
    "input": "visible-numeric-ascii-0x21-through-0x7e",
    "percent_escape_validation": true,
    "unsupported": [
      "userinfo",
      "ipv6-literal",
      "idna",
      "relative-resolution",
      "percent-decoding"
    ]
  },
  "utf8": {
    "strict": true,
    "rejects": [
      "overlong",
      "surrogate",
      "truncated",
      "above-u+10ffff"
    ]
  },
  "html": {
    "supported_elements": [
      "html",
      "head",
      "body",
      "p",
      "h1",
      "h2",
      "a",
      "form",
      "input",
      "img",
      "br",
      "style",
      "text"
    ],
    "semantic_attributes": {
      "a": [
        "href"
      ],
      "form": [
        "action"
      ],
      "input": [
        "name",
        "value"
      ],
      "img": [
        "src",
        "width",
        "height"
      ]
    },
    "quoted_attributes": "double-only",
    "quoted_attribute_controls": "reject-nul-non-whitespace-c0-del-lt-amp",
    "duplicate_attributes": "reject-ascii-case-insensitive",
    "style_content": "css-text-only",
    "strict_nesting": true,
    "recovery": false,
    "entities": false
  },
  "content_capabilities": [
    "document.html",
    "document.css",
    "document.links",
    "document.forms",
    "image.ppm"
  ],
  "css": {
    "selectors": [
      "body",
      "p",
      "h1",
      "h2",
      "a",
      "form",
      "input",
      "img"
    ],
    "properties": [
      "color",
      "background-color",
      "margin-top",
      "margin-bottom"
    ],
    "color": "#RRGGBB",
    "margins": "0..1024px",
    "comments": false
  },
  "layout": {
    "mode": "bounded-reference-flow",
    "boxes": [
      "text",
      "image",
      "input"
    ],
    "whitespace": "ascii-collapse-for-measurement",
    "scalar_reference": true
  },
  "image": {
    "codec": "Netpbm-P6",
    "capability": "image.ppm",
    "output": "RGBA8888",
    "alpha": 255,
    "max_dimension": 4096
  },
  "reference_vector": {
    "html_fixture": "fixtures/r7_document.html",
    "html_fixture_bytes": 428,
    "html_fixture_sha256": "0e39a26117b5a8774e3a06e76d00053362ddfacf280f1304df938619e06b0484",
    "html_fnv1a64": "3987ce4034e4f3fc",
    "node_count": 20,
    "css_rule_count": 5,
    "content_capability_count": 5,
    "utf8_sample_codepoints": 12,
    "layout_viewport_width": 120,
    "layout_box_count": 7,
    "document_height": 46,
    "layout_fnv1a64": "c207c69598198e47",
    "image_fixture": "fixtures/r7_image.ppm",
    "image_fixture_bytes": 23,
    "image_fixture_sha256": "69d84c9c40bbfe1bfa0519120af54a299af34be4eebb31bb6a34b67aaae22f00",
    "image_rgba_fnv1a64": "8a4318bc590ba10d",
    "link_secure": true,
    "link_port": 443,
    "proof": "examples/r7_document_proof.c",
    "layout_hash_encoding": "explicit-little-endian-u64-fields-plus-byte-colors"
  },
  "non_goals": [
    "network",
    "http",
    "tls",
    "browser-ui",
    "history",
    "bookmarks",
    "downloads",
    "relative-url-resolution",
    "html-recovery",
    "html-entities",
    "dom-mutation",
    "full-css",
    "font-engine",
    "png",
    "jpeg",
    "gif",
    "svg",
    "form-submit",
    "javascript",
    "accessibility-tree",
    "incremental-layout",
    "cache",
    "threads",
    "simd",
    "gpu"
  ]
}
