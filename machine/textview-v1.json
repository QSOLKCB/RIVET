{
  "schema": "rivet.textview/v1",
  "version": 1,
  "authority": "TEXTVIEW-v1.md",
  "role": "non-browser-proof-application",
  "framework_abi": false,
  "implementation": {
    "header": "apps/textview/textview.h",
    "source": "apps/textview/textview.c"
  },
  "dependencies": {
    "core": "rivet.core/v1",
    "gfx": "rivet.gfx/v1",
    "ui": "rivet.ui/v1"
  },
  "input_bytes": {
    "lf": "0x0a",
    "space": "0x20",
    "punctuation_digits": "0x2d-through-0x3a",
    "uppercase": "0x41-through-0x5a",
    "execution_character_set_independent": true
  },
  "memory": {
    "heap": false,
    "document_storage": "caller-owned",
    "line_index_storage": "caller-owned",
    "search_index": false
  },
  "operations": [
    "bounded-open",
    "line-up-down",
    "page-up-down",
    "exact-find-next-with-one-wrap",
    "deterministic-read-only-render"
  ],
  "headless_open_adapter": {
    "path": "platform/headless/text_file.c",
    "caller_buffer": true,
    "filesystem_contract": false
  },
  "reference_vector": {
    "fixture": "fixtures/r4_textview.txt",
    "fixture_bytes": 237,
    "fixture_sha256": "8d4a34353106071386727b776fa3089801563708dc521e0d363a447e12bb791e",
    "program": "examples/r4_textview_proof.c",
    "width": 192,
    "height": 48,
    "query_ascii_hex": "50 49 58 45 4c 53",
    "line_count": 9,
    "top_line": 4,
    "match_offset": 120,
    "fnv1a64": "c64fb52b456cde58",
    "ppm_sha256": "89a92f0fdfb2966a06b91ab50c3d2c905cf4eb340782d2df001dfe6cb369b95a",
    "fixture_eol": "lf-pinned-by-gitattributes"
  },
  "non_goals": [
    "browser",
    "network",
    "html",
    "css",
    "generic-text-decoder",
    "unicode",
    "lowercase-rendering",
    "text-editing",
    "document-mutation",
    "document-save-export",
    "filesystem-abstraction",
    "native-window",
    "native-input",
    "font-api",
    "layout-engine",
    "image-codec",
    "heap",
    "threads",
    "simd",
    "gpu",
    "cache",
    "search-index"
  ],
  "search": {
    "restart": "after-full-current-match-range",
    "wrap": "once-to-byte-zero-excluding-current-match",
    "oversized_supported_query": "RIVET_ERR_NOT_FOUND",
    "miss_preserves_previous_match": true
  },
  "rendering": {
    "viewport_write_boundary": "strict",
    "match_background_clipped_to_viewport": true
  }
}
